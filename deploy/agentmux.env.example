AGENTMUX_TOKEN=change-me-long-random-admin-token
AGENTMUX_PUBLIC_URL=https://hub.example.com
AGENTMUX_DATA=/var/lib/agentmux/agentmux.db
AGENTMUX_BIND=127.0.0.1:8080
# Optional WebRTC STUN/TURN hints for direct Web Control -> Worker transport.
# Keep this value on one line.
# AGENTMUX_P2P_ICE_SERVERS=[{"urls":["stun:turn.example.com:3478"]},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"agentmux","credential":"change-me"}]
AGENTMUX_P2P_ICE_SERVERS=
